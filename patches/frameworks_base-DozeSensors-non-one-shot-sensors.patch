@@ -569,6 +571,40 @@ public class DozeSensors {
         protected boolean mIgnoresSetting;
         private @DevicePostureController.DevicePostureInt int mPosture;
 
+        // Vendor gesture sensors that are wake-up but not one-shot (e.g. Motorola's
+        // "dt-gesture", com.motorola.sensor.double_tap, REPORTING_MODE_SPECIAL_TRIGGER) are
+        // rejected by requestTriggerSensor(). Listen to those with a plain listener instead.
+        private final SensorEventListener mContinuousListener = new SensorEventListener() {
+            @Override
+            public void onSensorChanged(SensorEvent event) {
+                handleTrigger(event.values, false /* oneShot */);
+            }
+
+            @Override
+            public void onAccuracyChanged(Sensor sensor, int accuracy) {
+            }
+        };
+
+        private boolean isOneShot(Sensor sensor) {
+            return sensor.getReportingMode() == Sensor.REPORTING_MODE_ONE_SHOT;
+        }
+
+        private boolean registerSensor(Sensor sensor) {
+            if (isOneShot(sensor)) {
+                return mSensorManager.requestTriggerSensor(this, sensor);
+            }
+            return mSensorManager.registerListener(mContinuousListener, sensor,
+                    SensorManager.SENSOR_DELAY_NORMAL);
+        }
+
+        private boolean unregisterSensor(Sensor sensor) {
+            if (isOneShot(sensor)) {
+                return mSensorManager.cancelTriggerSensor(this, sensor);
+            }
+            mSensorManager.unregisterListener(mContinuousListener, sensor);
+            return true;
+        }
+
